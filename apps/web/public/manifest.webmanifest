{
  "id": "/",
  "name": "WallyBot",
  "short_name": "WallyBot",
  "description": "Espacio privado de portafolio e investigación",
  "lang": "es",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#111113",
  "theme_color": "#111113",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Portafolio", "url": "/portfolio", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mercados", "url": "/markets", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Riesgo", "url": "/risk", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
