# Run: uv run python scripts/bootstrap.py
# It writes random secrets and a local .env without printing credentials.
# Production: change environment, HTTPS origin, secure cookie and review host firewall.
WALLY_ENVIRONMENT=local
WALLY_ORIGIN=http://localhost:3333
WALLY_COOKIE_SECURE=false
WALLY_BIND_IP=127.0.0.1
